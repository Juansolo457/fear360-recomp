From 468d61ce9347e281ab206756d5c04b5d167314ab Mon Sep 17 00:00:00 2001
From: juansolo457 <5344231+Juansolo457@users.noreply.github.com>
Date: Tue, 27 Oct 2026 14:31:51 -0700
Subject: [PATCH] core: guest memory shm unlinked once created, not at shutdown

CreateFileMappingHandle left the xenia_memory_* segment named in /dev/shm until
CloseFileMappingHandle, which a hard exit never reaches: each run leaked its touched guest
memory into tmpfs (half the RAM). On the Steam Deck a few restarts (game switches, settings)
filled it and the next guest page touched raised SIGBUS in a memcpy. Unlinked right after
ftruncate, the open descriptor keeps it alive and the kernel frees it at exit.
---
 src/core/memory_posix.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
index b52bf39..de959ea 100644
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -483,6 +483,11 @@ FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, siz
     shm_unlink(full_path.c_str());
     return kFileMappingHandleInvalid;
   }
+  // The descriptor keeps the memory; without a name the kernel frees it when the process ends,
+  // however it ends. Named, it outlived every hard exit (the usual way a title ends) in
+  // /dev/shm, a tmpfs of half the RAM: a few restarts filled it, and the next guest page touched
+  // raised SIGBUS. Nothing opens the mapping again by name.
+  shm_unlink(full_path.c_str());
   return static_cast<FileMappingHandle>(ret);
 #endif
 }
