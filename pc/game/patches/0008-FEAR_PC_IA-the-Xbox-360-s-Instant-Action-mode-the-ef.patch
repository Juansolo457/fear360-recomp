diff --git a/Game/ClientFxDLL/ClientFXVertexDeclMgr.cpp b/Game/ClientFxDLL/ClientFXVertexDeclMgr.cpp
index 8a49a0b..b3d2618 100644
--- a/Game/ClientFxDLL/ClientFXVertexDeclMgr.cpp
+++ b/Game/ClientFxDLL/ClientFXVertexDeclMgr.cpp
@@ -16,7 +16,11 @@ CClientFXVertexDeclMgr::CClientFXVertexDeclMgr() :
 
 CClientFXVertexDeclMgr::~CClientFXVertexDeclMgr()
 {
-	Term();
+	// This object is a global, destroyed when the DLL unloads. If the game quit without calling
+	// fxTermDLLRuntime, the engine's renderer is already gone by then and releasing through it
+	// crashes (an access violation here on quitting from a level). Only fxTermDLLRuntime, which
+	// runs while the engine is alive, releases the declaration.
+	m_hTexTangentSpace = NULL;
 }
 
 //called to initialize this object. This will return true if all vertex formats
diff --git a/Game/ClientShellDLL/ClientSaveLoadMgr.cpp b/Game/ClientShellDLL/ClientSaveLoadMgr.cpp
