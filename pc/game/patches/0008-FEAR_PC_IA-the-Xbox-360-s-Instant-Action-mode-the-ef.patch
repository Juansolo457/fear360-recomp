+#include "fear_ia.h"
+#endif
 
 // 
 // Globals...
@@ -283,6 +286,12 @@ bool CClientSaveLoadMgr::CanSaveGame()	const
 	return false;
 #endif
 
+#if defined(FEAR_PC_IA)
+	// No saving in Instant Action (pc/game/src/fear_ia.h).
+	if( FearIAActive( ))
+		return false;
+#endif
+
 	//can't save while on the mission summary screen, because we're between worlds
 	if (g_pMissionMgr->IsExitingLevel() || g_pMissionMgr->IsGameOver())
 		return false;
@@ -322,6 +331,12 @@ bool CClientSaveLoadMgr::CanSaveGame()	const
 
 bool CClientSaveLoadMgr::CanLoadGame( ) const
 { 
+#if defined(FEAR_PC_IA)
+	// No quick load in Instant Action (pc/game/src/fear_ia.h).
+	if( FearIAActive( ))
+		return false;
+#endif
+
 	//can't load while on the mission summary screen
 	if (g_pMissionMgr->IsExitingLevel())
 		return false;
