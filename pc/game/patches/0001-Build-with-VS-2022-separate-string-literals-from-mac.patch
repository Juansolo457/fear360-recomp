---
 Game/ClientFxDLL/dynalightfx.cpp     | 2 +-
 Game/ClientShellDLL/HUDChatInput.cpp | 2 +-
 Game/ObjectDLL/AI.cpp                | 4 ++--
 Game/ObjectDLL/ServerSpecialFX.cpp   | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Game/ClientFxDLL/dynalightfx.cpp b/Game/ClientFxDLL/dynalightfx.cpp
index 4fa9a0f..f8827fb 100644
--- a/Game/ClientFxDLL/dynalightfx.cpp
+++ b/Game/ClientFxDLL/dynalightfx.cpp
@@ -173,7 +173,7 @@ void fxGetDynaLightProps(CFastList<CEffectPropertyDesc> *pList)
 	fxProp.SetupFloatMin("Radius", 100.0f, 0.0f, eCurve_Linear, "The radius of the light (Point,Spot,Cubic)");
 	pList->AddTail(fxProp);
 
-	fxProp.SetupPath("Texture", "", "Texture Files (*.dds)|*.dds|Texture Animation Files (*."RESEXT_TEXTUREANIM")|*."RESEXT_TEXTUREANIM"|All Files (*.*)|*.*||", eCurve_None, "The texture associated with this light (Ambient,Spot,Cubic)");
+	fxProp.SetupPath("Texture", "", "Texture Files (*.dds)|*.dds|Texture Animation Files (*." RESEXT_TEXTUREANIM ")|*." RESEXT_TEXTUREANIM "|All Files (*.*)|*.*||", eCurve_None, "The texture associated with this light (Ambient,Spot,Cubic)");
 	pList->AddTail(fxProp);
 
 	fxProp.SetupFloatMinMax("Intensity", 1.0f, 0.0f, 2.0f, eCurve_Linear, "The intensity of this light 0-1 (All)");
diff --git a/Game/ClientShellDLL/HUDChatInput.cpp b/Game/ClientShellDLL/HUDChatInput.cpp
index 49ecb33..c719a4a 100644
--- a/Game/ClientShellDLL/HUDChatInput.cpp
+++ b/Game/ClientShellDLL/HUDChatInput.cpp
@@ -40,7 +40,7 @@ bool CHUDChatInput::Init()
 {
 	for (int i = 0; i < kMaxChatHistory; i++)
 	{
-		m_szChatHistory[i][0] = L'';
+		m_szChatHistory[i][0] = L'\0';
 	}
 
 	UpdateLayout();
